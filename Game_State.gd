extends Node

var next_spawn_point: String = ""

## ==============================================
## ฉากปลายทางต้องเล่นเนื้อเรื่องตอนมาถึงไหม
## ==============================================
## ฉากเดียวกันเข้าได้หลายทาง (เช่น p.tscn เข้าได้ทั้งจากแชทตอนเช้า และจากประตูฝั่งอื่น)
## แต่ฉากอินโทรต้องเล่น "เฉพาะตอนมาจากทางที่เนื้อเรื่องกำหนด" เท่านั้น
## ฝั่งที่สั่งเปลี่ยนฉากเป็นคนตั้งค่านี้ ฉากปลายทางอ่านแล้วต้อง**ล้างทิ้งทันที**
## ไม่งั้นเดินออกแล้วกลับเข้ามาใหม่ อินโทรจะเล่นซ้ำ
var pending_intro: String = ""

## ผู้เล่นมาถึงลานจอดรถหลังคุยแชทเสร็จ -> รถเมล์ออก แล้วน้ำฟ้าพูดว่าสาย
const INTRO_ARRIVE_BUS := "arrive_bus"

## ==============================================
## กล่องที่วาวาฝากให้ไปวาง
## ==============================================
## 🚨 **ต้องเก็บที่นี่ ไม่ใช่ที่ตัวผู้เล่น** — ผู้เล่นถูก instance ใหม่ทุกฉาก
## `player.carrying` จึงกลับเป็น false ทุกครั้งที่เปลี่ยนฉาก
## เดินออกจากห้องใต้ดินปุ๊บกล่องหายจากมือทันที แล้วเงื่อนไข "มีกล่อง" ที่ชั้น 2 จะเป็นเท็จเสมอ
##
## `player.gd` อ่านค่านี้ตอน `_ready()` และเขียนกลับให้เองทุกครั้งที่ `carrying` เปลี่ยน
## → ตั้ง `player.carrying = true` ที่ไหนก็ได้เหมือนเดิม ไม่ต้องมาแตะ GameState เอง

## ส่งตอนหยิบกล่องขึ้น/วางกล่องลง — ให้ HUD กับเควสต์ตามสถานะได้โดยไม่ต้องตรวจทุกเฟรม
signal carrying_box_changed(carrying: bool)

## ==============================================
## ธงเนื้อเรื่องตัวไหนก็ตามเปลี่ยนค่า — ส่งชื่อธงมาด้วย
## ==============================================
## มีคู่กับสัญญาณเฉพาะตัว (`carrying_box_changed`) โดยตั้งใจ ไม่ใช่ของซ้ำ:
##   สัญญาณเฉพาะตัว = สำหรับคนที่รู้ตั้งแต่เขียนโค้ดว่าสนใจธงไหน
##   สัญญาณตัวนี้    = สำหรับคนที่ **ชี้ชื่อธงเอาตอนกรอก Inspector** จึงไม่รู้ล่วงหน้า
##                     ว่าต้องไปฟังสัญญาณไหน (เช่น `quest_if` ของ `npc_base.gd`)
##
## ⚠️ ยิงเฉพาะธง **บูล** ที่เงื่อนไขต่าง ๆ ชี้ถึงได้ (`"if"` / `"unless"` / `quest_if`)
## `chapter` เป็น int ไม่ใช่ธง จึงมีสัญญาณของตัวเองแยกไว้
signal flag_changed(flag_name: String)

## ถือกล่องอยู่ในมือไหม
##
## ⚠️ ค่านี้เป็นจริงได้ก็ต่อเมื่อคุยกับวาวาจบแล้วเท่านั้น (กล่องล็อกอยู่ก่อนหน้านั้น)
## จึงใช้เป็นเงื่อนไข "คุยกับวาวาแล้ว + มีกล่อง + เป็นอนิเมชันถือกล่อง" ได้ครบในตัวแปรเดียว
##
## ⚠️ **setter เช็คค่าเดิมก่อน emit** (กฎเดียวกับ `chapter` ข้างล่าง)
## `player.gd._ready()` อ่านค่านี้แล้วเขียนกลับผ่าน setter ของ `carrying` ทุกครั้งที่เข้าฉากใหม่
## ไม่เช็คก่อน = ทุกฉากจะยิงสัญญาณ "หยิบกล่อง" ซ้ำทั้งที่ไม่มีอะไรเปลี่ยน
var carrying_box: bool = false:
	set(value):
		if value == carrying_box:
			return
		carrying_box = value
		carrying_box_changed.emit(carrying_box)
		flag_changed.emit("carrying_box")

## วางกล่องลงที่ห้องปลายทางเรียบร้อยแล้วหรือยัง
##
## แยกจาก `carrying_box` เพราะ "ไม่ได้ถืออยู่" กับ "วางเสร็จแล้ว" คนละเรื่อง
## (ก่อนคุยกับวาวาก็ไม่ได้ถือเหมือนกัน) · ใช้ให้กล่องยังโชว์อยู่ตอนเดินกลับเข้ามาดูอีกรอบ
##
## ⚠️ **ต้องมี setter ที่ยิงสัญญาณ ไม่ใช่ตัวแปรเปล่า** — โชแชงอยู่ในซีนเดียวกับจุดวางกล่อง
## (`all_level_2`) ผู้เล่นวางกล่องเสร็จโดยไม่มีการโหลดฉากใหม่เลย
## ไม่ยิงสัญญาณ = ไอคอนบนหัวโชจะไม่สลับจนกว่าจะเดินออกจากฉากแล้วกลับเข้ามา
##
## ⚠️ เช็คค่าเดิมก่อน emit เหมือน `carrying_box` — `box_drop_point.gd` อ่านค่านี้ตอน `_ready()`
## ของทุกฉากเพื่อคืนสภาพกล่องที่วางไว้แล้ว
var box_delivered: bool = false:
	set(value):
		if value == box_delivered:
			return
		box_delivered = value
		flag_changed.emit("box_delivered")

## ==============================================
## บทของเนื้อเรื่องตอนนี้ (1 = บทแรก)
## ==============================================
## ห้องที่ใช้เลย์เอาต์เดิมทุกบท (เช่น under.tscn) อ่านค่านี้เพื่อเลือกชุดของตกแต่ง + NPC
## เปลี่ยนค่าเมื่อไหร่ ห้องที่เปิดอยู่จะสลับของให้เองผ่านสัญญาณนี้ ไม่ต้องโหลดฉากใหม่
signal chapter_changed(new_chapter: int)

var chapter: int = 1:
	set(value):
		if value == chapter:
			return   ## ตั้งค่าเดิมซ้ำ ไม่ต้องรื้อของทั้งห้องสร้างใหม่
		chapter = value
		chapter_changed.emit(chapter)
