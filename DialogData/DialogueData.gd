extends Resource
class_name DialogueData

@export var dialogues := {
	## ── ระบบ NPC ใหม่ (npc/) ใช้คีย์ที่อ่านออกว่าเป็นใคร ตั้งที่ไฟล์ .tres ของแต่ละตัว ──
	"wawa_intro": [
		{"name": "น้ำฟ้า", "text": "สวัสดีค่ะพี่วา สบายดีนะคะ"},
		{"name": "พี่วา", "text": "สบายดีจ้า พึ่งกินข้าวมาเลย"},
		{"name": "พี่วา", "text": "แล้วเรากินข้าวรึยัง?"},
		{"name": "น้ำฟ้า", "text": "กินแล้วค่ะ"}
	],

	## ห้องใต้ตึก บทที่ 1 — น้ำฟ้ามาช่วยยกของ วาวาฝากกล่องสุดท้ายให้ไปวางที่ห้องรับรอง
	## (ตั้งที่ช่อง `dialogue_id_override` ของโหนด Wawa ใน decor/under_ch_1.tscn
	##  ไม่ได้ตั้งใน wawa.tres เพราะวาวาที่ level_2 ใช้ .tres ใบเดียวกันแต่คนละบท)
	"wawa_under_ch1": [
		{"name": "น้ำฟ้า", "text": "สวัสดีค่ะ หนูมาช่วยยกของค่ะ"},
		{"name": "วาวา", "text": "อ๋อ เรานี่เอง เพื่อน ๆ ยกที่เหลือไปแล้ว เหลือแค่กล่องนี้เลยคับ"},
		{"name": "วาวา", "text": "ยังไงก็ขอบคุณมากน้า เอาไปวางไว้ให้ห้องรับรองได้เลยนะ เดี๋ยวพี่ตามไป"},
		{"name": "น้ำฟ้า", "text": "ได้เลยค่ะ"},
		{"name": "วาวา", "text": "จะว่าไปแล้วเรากินข้าวรึยังนะ ไม่กินเนี่ยแย่เลย"},

		## ตัวเลือก: ซ้าย = index 0 · ขวา = index 1 (ดู CHOICE_BUTTON_PATHS ใน dialogue_system.gd)
		## บรรทัดแรกของ "then" คือคำที่น้ำฟ้าพูดจริง — ปุ่มกับบทพูดเป็นคนละข้อความ ตั้งต่างกันได้
		## บรรทัดสุดท้ายของแต่ละสายใส่ "hold" ไว้ = พิมพ์จบแล้วรอครู่เดียวบทก็ปิดเอง (กด E ข้ามได้)
		{"choices": [
			{"text": "กินแล้วค่ะ", "then": [
				{"name": "น้ำฟ้า", "text": "กินแล้วค่ะ"},
				{"name": "วาวา", "text": "เก่งมาก!"},
				{"name": "วาวา", "text": "ไม่กินเนี่ยโดนพี่คีรินเขาดุแย่"},
				{"name": "วาวา", "text": "รายนั้นจริงจังกับการกินข้าวมากเลยนะ"},
				{"name": "น้ำฟ้า", "text": "แล้วพี่วากินหรือยังคะ"},
				{"name": "วาวา", "text": "ก็...ยังเลย แต่เดี๋ยวพี่กิน! เราน่ะทำงานเลย!", "hold": 5.0}
			]},
			{"text": "อ๋อ...ยังเลยค่ะ", "then": [
				{"name": "น้ำฟ้า", "text": "อ๋อ...ยังเลยค่ะ"},
				{"name": "วาวา", "text": "ฮั่นแน่ ไม่กินแบบนี้ระวังโดนพี่คีรินเขาดุเอานะ"},
				{"name": "น้ำฟ้า", "text": "เดี๋ยวจะกินค่ะ เหอะ ๆ"},
				{"name": "วาวา", "text": "ก็ได้ ๆ แต่อย่าให้รู้เชียวว่าไม่กิน"},
				{"name": "น้ำฟ้า", "text": "เหอะ ๆ ค่ะ", "hold": 5.0}
			]}
		]}
	],

	## บทคุยซ้ำของวาวา — ใช้หลังคุยบทหลักจบแล้ว (ตั้งที่ช่อง `dialogue_id_after` ของโหนด)
	##
	## เนื้อเรื่องเดินไปแล้ว แต่ผู้เล่นยังเดินกลับมากด E ได้อยู่ดี
	## บทหลักจะซ้ำไม่ได้ (วาวาจะฝากกล่องซ้ำ) ต้องมีอะไรให้พูดแทน
	##
	## ⚠️ **เป็นบทชั่วคราว** ไว้กันความเงียบ — ตั้งใจให้เปลี่ยนเป็นบทจริงทีหลัง
	## เปลี่ยนได้ที่นี่ที่เดียว ไม่ต้องแตะสคริปต์ (หรือชี้ `dialogue_id_after` ไปคีย์อื่น)
	"wawa_idle": [
		## "random_text" = สุ่มหนึ่งประโยคตอนขึ้นบรรทัดนี้ · ไม่พูดประโยคเดิมซ้ำติดกัน
		{"name": "วาวา", "random_text": [
			"มีอะไรสงสัยไหม?",
			"อยากให้ช่วยอะไรเหรอ?",
		]},
		## index 0 = ปุ่มซ้าย · index 1 = ปุ่มขวา (ดู CHOICE_BUTTON_PATHS ใน dialogue_system.gd)
		## เอา "กล่องไหนเหรอคะ" ไว้ซ้ายเพราะเป็นตัวเลือกที่บอกวิธีเล่นต่อ
		## บทนี้เล่นได้ก็ต่อเมื่อคุยบทหลัก (`wawa_under_ch1`) จบไปแล้ว = ฝากกล่องไปแล้วแน่นอน
		{"choices": [
			{"text": "กล่องไหนเหรอคะ", "then": [
				{"name": "น้ำฟ้า", "text": "กล่องไหนเหรอคะ"},
				{"name": "วาวา", "text": "กล่องบนโต๊ะเลย"},
				{"name": "วาวา", "text": "เดินไปใกล้ ๆ แล้วจะมีแสงสีเหลืองขึ้น ยกไปได้เลยนะ", "hold": 5.0},
			]},
			{"text": "ไม่มีค่ะ", "then": [
				{"name": "น้ำฟ้า", "text": "ไม่มีอะไรค่ะ", "hold": 2.0},
			]},
		]},
	],

	## ── NPC ที่กำลังทำอยู่ (ยังไม่มีซีนสืบทอด ยังไม่ได้วางลงฉาก) ──
	##
	## ⚠️ **เป็นบทตั้งต้นไว้กันคีย์หาย ไม่ใช่บทจริง** — ตั้งใจให้เขียนทับ
	## `.tres` ของทั้งสองตัวชี้คีย์พวกนี้อยู่แล้ว ไม่มีคีย์ = กด E แล้ว "ไม่มีอะไรเกิดขึ้น"
	## ซึ่งดูเหมือนระบบ NPC พังทั้งระบบ ทั้งที่แค่ยังไม่ได้เขียนบท
	##
	## 🚨 **ชื่อคีย์สะกดตาม `.tres` เป๊ะ ๆ ห้ามแก้ให้สวยขึ้นที่นี่ที่เดียว**
	## `Cho.tres` เขียน `"Cho_intro"` (C ตัวใหญ่) แต่ `Kirin.tres` เขียน `"kirin_intro"` (ตัวเล็ก)
	## รู้ว่าไม่สม่ำเสมอ แต่ต้องแก้พร้อมกันทั้งสองที่ ไม่งั้นหาบทไม่เจอ

	## โชแชงอยู่ชั้น 2 — เป็นคนที่ผู้เล่นเดินผ่านระหว่างถือกล่องไปหาห้องรับรอง
	## จึงเป็นที่ที่ผู้เล่นซึ่งหาห้องไม่เจอจะเดินมาถามโดยสัญชาตญาณ
	"Cho_intro": [
		{"name": "โชแชง", "text": "อรุณสวัสดิ์น้ำฟ้า มีอะไรรึเปล่า?"},

		## `"if": "carrying_box"` = ข้อนี้โผล่เฉพาะตอนถือกล่องอยู่ในมือ
		## เห็นเฉพาะตอนที่คำถามมีความหมายจริง ๆ — วางไปแล้วหรือยังไม่ได้รับกล่องก็ไม่ต้องมี
		{"choices": [
			## ⚠️ ข้อความบนปุ่มสั้นกว่าคำที่น้ำฟ้าพูดจริงโดยตั้งใจ — ปุ่มมีที่จำกัด
			## บรรทัดล่างคือคำพูดจริง แก้ปุ่มแล้วอย่าลืมว่าไม่ต้องแก้ตาม
			{"text": "กล่อง", "if": "carrying_box", "then": [
				{"name": "น้ำฟ้า", "text": "กล่องวางตรงไหนเหรอคะ"},
				{"name": "โชแชง", "text": "วางในห้องรับรองเลย ห้องเล็ก ๆ ถัดไปนี้เอง"},
				{"name": "โชแชง", "text": "ลองดูในแมพก็ได้นะ", "hold": 3.0},
			]},
			{"text": "ไม่มีค่ะ", "then": [
				{"name": "น้ำฟ้า", "text": "ไม่มีค่ะ", "hold": 2.0},
			]},
		]},
	],

	## บทคุยซ้ำของโชแชง — ใช้ตั้งแต่ครั้งที่ 2 เป็นต้นไป
	## (ตั้งที่ช่อง `dialogue_id_after` ของโหนด `Cho` ใน `all_level_2.tscn`)
	##
	## 🚨 **ไม่ทักทายซ้ำ** — "อรุณสวัสดิ์" เป็นคำทักตอนเจอกันครั้งแรกของวัน
	## พูดซ้ำทุกครั้งที่เดินมากด E จะทำให้ตัวละครดูเหมือนหุ่นที่ลืมว่าเพิ่งคุยกันไป
	## เปลี่ยนเป็นคำถามที่ต่อจากบทสนทนาที่มีอยู่แล้วแทน
	"Cho_idle": [
		{"name": "โชแชง", "text": "อยากให้ช่วยอะไรไหม?"},
		## ตัวเลือกเดียว = ขึ้นปุ่มฝั่งซ้าย (index 0)
		{"choices": [
			{"text": "ไม่มีค่ะ", "then": [
				{"name": "น้ำฟ้า", "text": "ไม่มีค่ะ", "hold": 2.0},
			]},
		]},
	],

	## บทเควส "ไปเอาเบรค" ของโชแชง — ใช้ช่วงที่วางกล่องเสร็จแล้วแต่ยังไม่ได้รับขนมปัง
	## (ตั้งที่ `Cho.tres`: `quest_if = "box_delivered"` · `quest_unless = "has_bread"`
	##  · `quest_dialogue_id = "Cho_break"`) ไอคอนเควสบนหัวโชใช้เงื่อนไขคู่เดียวกันเป๊ะ
	##
	## 🚨 **`{"set": "has_bread"}` อยู่ก่อนบรรทัดสุดท้าย ไม่ใช่หลัง**
	## บรรทัดสุดท้ายมี `"hold"` ซึ่ง **ปิดบทเองเมื่อครบเวลา** — วางไว้หลังจากนั้น
	## บรรทัดตั้งธงจะไม่มีวันถูกอ่าน แล้วขนมปังจะไม่เข้าช่องของ
	## · วางตรงนี้ยังอ่านเป็นเรื่องได้ลื่นกว่าด้วย: โชยื่นขนมปังให้ แล้วน้ำฟ้าค่อยขอบคุณ
	"Cho_break": [
		{"name": "โชแชง", "text": "มาเอาเบรคใช่ไหม?"},
		{"name": "น้ำฟ้า", "text": "ใช่ค่ะ"},
		{"name": "โชแชง", "text": "วันนี้เป็นขนมปังนะ อร่อยอยู่"},
		{"set": "has_bread"},
		{"name": "น้ำฟ้า", "text": "ขอบคุณมากนะคะ"},

		## ⚠️ **ฝากงานต่อทันทีในบทเดียวกัน ไม่แยกเป็นบทใหม่** — ผู้เล่นเพิ่งกด E ครั้งเดียว
		## แยกเป็นอีกบทแปลว่าต้องกด E ซ้ำถึงจะได้ยิน ซึ่งไม่มีอะไรบอกว่าต้องกด
		{"name": "โชแชง", "text": "ยังไงถ้าเรากินเสร็จแล้ว พี่รบกวนเราหน่อยได้ไหม?"},
		{"name": "น้ำฟ้า", "text": "อะไรเหรอคะ"},
		## วัดแล้วยาวเท่านี้ยังอยู่บรรทัดเดียวใน `TextPanel` (35 จาก 200 px) ไม่ต้องหั่น
		## ⚠️ `TextLabel` ตั้ง `scroll_active = false` — ข้อความล้นจะ**ถูกตัดหายเงียบ ๆ**
		## ไม่มีสกรอลล์ ไม่มี error · บทยาวกว่านี้มากควรวัดก่อนด้วย `get_content_height()`
		{"name": "โชแชง", "text": "พอดีเริ่มมีน้อง ๆ มาบ้างแล้ว ยังไงเราแวะเข้าไปในห้องประชุม ไปช่วยพี่คนอื่น ๆ จัดน้องหน่อยได้ไหม?"},
		{"name": "น้ำฟ้า", "text": "ได้ค่ะ ไว้หนูจะไปค่ะ", "hold": 2.0},

		## 🚨 **อยู่ *หลัง* บรรทัด `hold` ได้ ต่างจาก `{"set": "has_bread"}` ข้างบน**
		## `hold` เรียก `_advance()` เมื่อครบเวลา = **เลื่อนไปบรรทัดถัดไป** ไม่ใช่ปิดบททิ้ง
		## (ปิดบทก็ต่อเมื่อไม่มีบรรทัดถัดไปแล้วเท่านั้น)
		## → วางตรงนี้ธงจะถูกตั้งตอนประโยค "ได้ค่ะ ไว้หนูจะไปค่ะ" **จบพอดี** ตามที่ต้องการ
		## แล้ว `_run_set_flag_line()` เห็นว่าหมดคิวก็ปิดบทให้เอง
		{"set": "cho_asked_help"},
	],

	## คีรินเป็นคนที่วาวาพูดถึงว่า "จริงจังกับการกินข้าวมาก"
	## บทตั้งต้นเลยให้ถามเรื่องกินข้าวก่อนเรื่องอื่น จะได้ต่อกับที่วาวาปูไว้
	"kirin_intro": [
		{"name": "คีริน", "random_text": [
			"กินข้าวมารึยัง",
			"วันนี้กินอะไรมาบ้าง",
		]},
		{"name": "น้ำฟ้า", "text": "กินแล้วค่ะ"},
		{"name": "คีริน", "text": "ดี ทำงานตอนท้องว่างเดี๋ยวก็ล้มหรอก", "hold": 3.0},
	],

	## ── ระบบเดิม (NPC.gd + wawa.tscn ที่ root) — ลบทิ้งได้เมื่อย้ายมาใช้ npc/ ครบ ──
	"npc1": [
		{"name": "น้ำฟ้า", "text": "สวัสดีค่ะพี่วา สบายดีนะคะ"},
		{"name": "พี่วา", "text": "สบายดีจ้า พึ่งกินข้าวมาเลย"},
		{"name": "พี่วา", "text": "แล้วเรากินข้าวรึยัง?"},
		{"name": "น้ำฟ้า", "text": "กินแล้วค่ะ"}
	],
	

	"npc2": [
		{"name": "พี่โช", "text": "เฮ้ วันนี้เป็นไงบ้าง"},
		{"name": "น้ำฟ้า", "text": "ก็เรื่อย ๆ เลยค่ะ"}
	]
}
