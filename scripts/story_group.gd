extends Node2D
## ==============================================
## กลุ่มของในฉากที่ "โผล่เมื่อเนื้อเรื่องถึงคิว"
## ==============================================
## แนบที่โหนดที่ห่อ NPC/ของไว้ → ลูกทั้งกลุ่มถูกซ่อนจนกว่าธงใน `GameState` จะเป็นจริง
## เพิ่มตัวละครเข้ากลุ่มทีหลังก็แค่ลากเข้าไปเป็นลูก ไม่ต้องแตะโค้ดและไม่ต้องต่อสัญญาณเพิ่ม
##
## 🚨 **แนบที่โหนด "กลุ่มของที่มาทีหลัง" เท่านั้น ห้ามแนบที่โหนดที่มีของเดิมปนอยู่**
## เช่น `level2_2` มีโชแชงอยู่ ซึ่งต้องเห็นตั้งแต่ต้นฉาก (ไม่งั้นไม่มีใครให้คุยด้วย
## แล้วธงจะไม่มีวันถูกตั้ง = เกมตัน) → ทำโหนดใหม่แยกไว้สำหรับกลุ่มที่มาทีหลัง
##
## ⚠️ **ซ่อน ไม่ใช่ลบ/สร้างใหม่** — โหนดอยู่ในซีนตลอดเวลา จัดตำแหน่งเห็นได้ในเอดิเตอร์
## และไม่ต้องกังวลว่า `_ready()` ของ NPC จะรันตอนไหน (กฎเดียวกับ `Level2_1` ของเควสกล่อง
## ที่จดไว้ว่า *"เงื่อนไขเนื้อเรื่องอยู่ที่ 'โชว์อะไรไหม' ไม่ใช่ 'สร้างโหนดไหม'"*)

## ส่งตอนกลุ่มนี้โผล่เข้าฉาก — เผื่อเนื้อเรื่องอยากดักต่อ
signal appeared

## ชื่อธง**บูล**ใน `GameState` ที่ต้องเป็นจริง กลุ่มนี้ถึงจะโผล่
##
## รูปแบบเดียวกับ `quest_if` ของ `NPCData` และคีย์ `"if"` ของตัวเลือกในบทสนทนา
## — ชี้ชื่อตัวแปรตรง ๆ ไม่ต้องเขียนโค้ดเพิ่ม
@export var show_if: String = ""

## เตือนชื่อธงผิดครั้งเดียวต่อโหนด — `_refresh()` ถูกเรียกทุกครั้งที่ธงใดก็ตามขยับ
var _warned: bool = false


func _ready() -> void:
	if Engine.is_editor_hint():
		return

	if show_if.strip_edges().is_empty():
		push_warning("story_group.gd: `%s` ไม่ได้ตั้ง `Show If` — กลุ่มนี้จะโชว์ตลอดเวลา" % name)
		return

	## ⚠️ ต่อสัญญาณก่อนแล้วค่อย `_refresh()` — ธงอาจถูกตั้งไปแล้วตั้งแต่ฉากก่อนหน้า
	## (ผู้เล่นคุยกับโชจบแล้วเดินขึ้นบันไดไปชั้นอื่นแล้วกลับมา) ต้องอ่านค่าปัจจุบันด้วย
	## ไม่ใช่รอสัญญาณอย่างเดียว — กฎเดียวกับ HUD ที่ถูก instance ใหม่ทุกฉาก
	GameState.flag_changed.connect(_on_flag_changed)
	_refresh()


func _on_flag_changed(flag_name: String) -> void:
	if flag_name != show_if.strip_edges():
		return
	_refresh()


## จุดเดียวที่แตะ `visible` ของกลุ่ม
func _refresh() -> void:
	var was_visible: bool = visible
	visible = _flag_ok()
	if visible and not was_visible:
		appeared.emit()


## ⚠️ **พิมพ์ชื่อธงผิด → ซ่อนไว้ + `push_error`** ไม่ใช่โชว์ทิ้งไว้
## โชว์ไว้จะได้ตัวละครที่โผล่ผิดจังหวะเนื้อเรื่องแบบเงียบ ๆ ซึ่งหาสาเหตุยากกว่า
## กลุ่มที่ไม่ยอมโผล่ (อันหลังอย่างน้อยก็เห็นชัดว่ามีอะไรผิด)
func _flag_ok() -> bool:
	var flag: String = show_if.strip_edges()
	if flag.is_empty():
		return true

	if not flag in GameState:
		if not _warned:
			_warned = true
			push_error("story_group.gd: `%s` ตั้ง `Show If` = '%s' แต่ไม่มีตัวแปรชื่อนี้ใน GameState" \
				% [name, flag])
		return false

	return bool(GameState.get(flag))
