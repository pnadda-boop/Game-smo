class_name NPCNote
extends VBoxContainer
## ==============================================
## สมุดจดข้อกำหนด — โชว์ข้อกำหนดของ NPC ตัวที่กำลังคลิกดูอยู่
## ==============================================
## แนบที่ `CanvasLayer/Book/VBoxContainer` ใน `align_1.tscn`
##
## **สมุด = ภาพสะท้อนของบับเบิลตัวที่กำลังดูอยู่** ไม่ใช่ที่สะสมของทุกคน
## คลิกดูตัวใหม่ → ทับของเดิม · ปิดบับเบิล → ล้างสมุด
## (ตกลงกันไว้ 2026-08-19 — เหตุผลอยู่ใน DEVLOG)
##
## **ข้อความมาจากที่เดียวกับบับเบิลเป๊ะ ๆ** (`NPCalignDatabase.get_dialogue()`)
## จงใจไม่ให้สมุดไปดึงข้อมูลเอง — สองที่ที่อ่านคนละแหล่งแล้ววันหลังแก้ไม่ครบ
## จะได้บับเบิลพูดอย่าง สมุดจดอีกอย่าง ซึ่งผู้เล่นเชื่อสมุดแล้วแพ้

## กลุ่มที่ `click.gd` ใช้หาสมุด — เข้ากลุ่มเองจากโค้ด ไม่ต้องตั้งในซีน
const GROUP := "npc_note"

## Label ลูกทุกตัวเรียงตามลำดับในซีน = บรรทัดที่ 1, 2, 3, ...
##
## ⚠️ **เก็บอัตโนมัติ ไม่ได้ผูกกับชื่อ `Label1` / `Label2`**
## อยากได้ข้อกำหนด 3 บรรทัดวันหลัง แค่เพิ่ม Label ในซีน ไม่ต้องแตะไฟล์นี้
## (เหตุผลเดียวกับที่ `StandZone` นับช่องยืนจากลูกที่มี Marker2D)
var _lines: Array[Label] = []

## id ของ NPC ที่ข้อความบนสมุดตอนนี้เป็นของ ("" = สมุดว่าง)
##
## 🚨 **จำเป็น เพราะบับเบิลเปิดพร้อมกันได้หลายใบ** — `click.gd` เก็บบับเบิลไว้ที่ NPC
## แต่ละตัว คลิกตัวที่สองไม่ได้ปิดใบแรก · ถ้าล้างสมุดทันทีที่บับเบิลใบไหนก็ได้ปิดลง
## ปิดใบเก่าจะลบข้อความของตัวที่เพิ่งคลิกดูไปด้วย ทั้งที่บับเบิลของมันยังเปิดอยู่
var _owner_id: String = ""

## เตือนเรื่องบรรทัดล้นแค่ครั้งเดียวต่อ NPC หนึ่งตัว ไม่ให้ท่วมคอนโซล
var _overflow_warned: Dictionary = {}


func _ready() -> void:
	add_to_group(GROUP)

	for child in get_children():
		if child is Label:
			_lines.append(child)

	if _lines.is_empty():
		push_warning("NPCNote ที่ '%s' ไม่มี Label ลูกสักตัว — สมุดจะไม่โชว์อะไรเลย" % name)

	## ล้างข้อความที่พิมพ์ค้างไว้ตอนแก้ซีน — สมุดต้องว่างจนกว่าจะมีคนคลิกดูตัวละคร
	clear()


## จดข้อกำหนดของ NPC ลงสมุด — `text` คือข้อความชุดเดียวกับที่บับเบิลใช้
##
## ตัดบรรทัดด้วย `\n` แล้วใส่ทีละ Label ตามลำดับ
## `strip_edges()` เพราะช่องว่างหน้าบรรทัดใน `NPC_DATA` (เช่น NPC6 " -ฉันอยากอยู่ด้านหลัง")
## เป็นการจัดหน้าให้บับเบิล ไม่ใช่ของสมุดซึ่งจัดชิดซ้ายอยู่แล้ว
func write(npc_id: String, text: String) -> void:
	_owner_id = npc_id

	var parts := text.split("\n")
	for i in _lines.size():
		_lines[i].text = parts[i].strip_edges() if i < parts.size() else ""

	## บรรทัดเกินจำนวน Label = ข้อกำหนดข้อนั้นหายไปเงียบ ๆ ซึ่งทำให้ปริศนาแก้ไม่ได้
	## โดยไม่มีอะไรบอก — ต้องเตือนดัง ๆ ว่าต้องไปเพิ่ม Label ในซีน
	if parts.size() > _lines.size() and not _overflow_warned.has(npc_id):
		_overflow_warned[npc_id] = true
		push_warning("ข้อกำหนดของ '%s' มี %d บรรทัด แต่สมุดมีแค่ %d Label — เพิ่ม Label ในซีนก่อน" \
				% [npc_id, parts.size(), _lines.size()])


## ล้างสมุด **เฉพาะเมื่อข้อความบนนั้นเป็นของ `npc_id`**
## ตัวที่ปิดบับเบิลทีหลังแต่ไม่ได้เป็นเจ้าของข้อความปัจจุบัน เรียกแล้วไม่เกิดอะไร
func erase(npc_id: String) -> void:
	if _owner_id != npc_id:
		return
	clear()


func clear() -> void:
	_owner_id = ""
	for line in _lines:
		line.text = ""
